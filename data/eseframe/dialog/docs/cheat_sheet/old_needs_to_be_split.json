{
  "type": "minecraft:notice",
  "title": "Eseframe Documentation: Cheat Sheet",
  "external_title": "TODO Old cheat sheet, split this into pages",
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": [
        "",
        [
          "",
          {
            "text": "Custom Tag Recipes",
            "extra": [
              "\n"
            ],
            "bold": true
          },
          "\n",
          [
            "",
            {
              "text": "Add custom recipe to tag",
              "underlined": true,
              "extra": [
                "\n"
              ],
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "function eseframe_api:v1/tag_recipe {id:\"RECIPE_ID\",namespace:\"RECIPE_NAMESPACE\",tag_id:\"TAG_ID\",tag_namespace:\"TAG_NAMESPACE\"}"
              }
            },
            {
              "text": "(in #eseframe_api:v1/register/recipe_tags)",
              "color": "gray",
              "extra": [
                "\n",
                "Tags are created automatically when set",
                "\n"
              ]
            }
          ],
          "\n",
          [
            "Define recipe results",
            "\n",
            {
              "text": "with loot table <namespace>:eseframe_api/recipe/<id>",
              "color": "gray",
              "extra": [
                "\n"
              ]
            }
          ],
          "\n\n",
          {
            "text": "Craft first recipe as player",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: false}"
            }
          },
          "\n",
          {
            "text": "Craft first valid recipe with block",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: true}"
            }
          }
        ]
      ]
    }
  ],
  "inputs": [],
  "after_action": "none",
  "pause": false,
  "action": {
    "label": {
      "translate": "gui.ok"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "eseframe:docs/cheat_sheet/index"
    }
  }
}