{
  "type": "minecraft:notice",
  "title": "Eseframe Documentation: Cheat Sheet - Recipes",
  "external_title": "Recipes",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "",
          "italic": true
        },
        {
          "text": "Click on ",

          "extra": [
            "",
            {
              "text": "underlined text",
              "underlined": true,

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "underlined text"
              }
            },
            " to copy it to the clipboard.",
            "\n"
          ]
        },
        {
          "text": "Some lines will give you extra info when you hover over them.",
          "color": "gray",

          "hover_event": {
            "action": "show_text",
            "value": "Tooltips are used to provide relevant details about the line; For example, a tooltip may include the context a function should be ran under."
          }
        }
      ]
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": [
        "",
        {
          "text": "Adding New Recipes",
          "color": "gold",
          "bold": true,
          "extra": ["\n"]
        },

        "\n",

        [
          "",
          {
            "text": "Register a recipe:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "function eseframe_api:v1/add_recipe {id:\"<recipe_id>\",namespace:\"<recipe_namespace>\",ingredients:[{type:\"item\",item:\"minecraft:stone\",count:1}],properties:{}}",
            "color": "gray",
            "underlined": true,
            "extra": ["\n"],

            "hover_event": {
              "action": "show_text",
              "value": [
                "DURING function tag #eseframe_api:v1/register/recipes"
              ]
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/add_recipe {id:\"<recipe_id>\",namespace:\"<recipe_namespace>\",ingredients:[{type:\"item\",item:\"minecraft:stone\",count:1}],properties:{}}"
            }
          }
        ],
        "\n\n",
        [
          "",
          {
            "text": "Set what items a recipe gives when crafted:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "Define loot table <recipe_namespace>:eseframe_api/recipe/<recipe_id>",
            "color": "gray",

            "hover_event": {
              "action": "show_text",
              "value": [
                "Path: <your_datapack>/data/<recipe_namespace>/loot_table/eseframe_api/recipe/<recipe_id>.json",
                "\n",
                "TIP: You can use Item Proxies to give a player a custom item when they craft your recipe!"
              ]
            }
          }
        ]
      ]
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": [
        "",
        {
          "text": "Ingredients",
          "color": "gold",
          "bold": true,
          "extra": ["\n"]
        },

        "\n",

        [
          "",
          {
            "text": "Custom item added with Eseframe:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "{type:\"custom_item\",id:\"<recipe_id>\",namespace:\"<recipe_namespace>\",count:1}",
            "color": "gray",
            "underlined": true,
            "extra": ["\n"],

            "hover_event": {
              "action": "show_text",
              "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "{type:\"custom_item\",id:\"<recipe_id>\",namespace:\"<recipe_namespace>\",count:1}"
            }
          }
        ],
        "\n\n",
        [
          "",
          {
            "text": "Regular item:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "{type:\"item\",item:\"minecraft:ITEM_ID\",count:1}",
            "color": "gray",
            "underlined": true,
            "extra": ["\n"],

            "hover_event": {
              "action": "show_text",
              "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",count:1}"
            }
          }
        ],
        "\n\n",
        [
          "",
          {
            "text": "Regular item with components:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "{type:\"item\",item:\"minecraft:ITEM_ID\",predicates:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}",
            "color": "gray",
            "underlined": true,
            "extra": ["\n"],

            "hover_event": {
              "action": "show_text",
              "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",predicates:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}"
            }
          }
        ],
        "\n\n",
        [
          "",
          {
            "text": "Regular item with exact components:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "{type:\"item\",item:\"minecraft:ITEM_ID\",components:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}",
            "color": "gray",
            "underlined": true,

            "hover_event": {
              "action": "show_text",
              "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",components:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}"
            }
          }
        ]
      ]
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": [
        "",
        {
          "text": "Crafting",
          "color": "gold",
          "bold": true,
          "extra": ["\n"]
        },

        "\n",

        [
          "",
          {
            "text": "Craft a recipe with a player's items:",
            "color": "gray",
            "extra": ["\n"]
          },
          {
            "text": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:false}",
            "color": "gray",
            "underlined": true,
            "extra": ["\n"],

            "hover_event": {
              "action": "show_text",
              "value": [
                "AS the player with the ingredients"
              ]
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:false}"
            }
          }
        ],
        "\n\n",
        [
          "",
          {
            "text": "Craft a recipe with a block's items:",
            "color": "white",
            "extra": ["\n"]
          },
          {
            "text": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:true}",
            "color": "gray",
            "underlined": true,

            "hover_event": {
              "action": "show_text",
              "value": [
                "AS the player to credit the crafting to",
                "\n",
                "AT the block with the ingredients"
              ]
            },

            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:true}"
            }
          }
        ]
      ]
    }
  ],
  "inputs": [],
  "after_action": "none",
  "pause": false,
  "action": {
    "label": {
      "translate": "gui.ok"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "eseframe:docs/cheat_sheet/index"
    }
  }
}