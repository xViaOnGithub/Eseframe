{
  "type": "minecraft:notice",
  "body": {
    "type": "minecraft:plain_message",
    "contents": [
      "",
      "Tries to craft a custom recipe with the items of a player or a block.\n",
      "\n\n",
      [
        "",
        {
          "text": "Description",
          "extra": [
            "\n"
          ],
          "bold": true
        },
        {
          "text": "Attempts to craft every custom recipe in a custom recipe tag until either one succeeds or it runs out of recipes to try. It does this by invoking `eseframe_api-v1:craft` with every recipe in the tag.",
          "color": "gray",
          "extra": [
            "\n"
          ]
        }
      ],
      "\n\n",
      [
        "",
        {
          "text": "Macro Keys",
          "extra": [
            "\n"
          ],
          "color": "blue",
          "bold": true,
          "underlined": true,
          "click_event": {
            "action": "open_url",
            "url": "https://minecraft.wiki/w/Function_(Java_Edition)#Macros"
          },
          "hover_event": {
            "action": "show_text",
            "value": "https://minecraft.wiki/w/Function_(Java_Edition)#Macros"
          }
        },
        {
          "text": "id",
          "extra": [
            " ",
            {
              "text": "string",
              "italic": true
            },
            " : ",
            {
              "text": "The id of the recipe tag to attempt recipes from",
              "color": "gray"
            },
            "\n"
          ]
        },
        {
          "text": "addon",
          "extra": [
            " ",
            {
              "text": "string",
              "italic": true
            },
            " : ",
            {
              "text": "The addon the recipe tag is added under",
              "color": "gray"
            },
            "\n"
          ]
        },
        {
          "text": "block",
          "extra": [
            " ",
            {
              "text": "booleen",
              "italic": true
            },
            " : ",
            {
              "text": "When set to true, check for ingredients at and send results to the block that the function is invoked at",
              "color": "gray"
            },
            "\n"
          ]
        }
      ],
      "\n\n",
      [
        "",
        {
          "text": "Return Values",
          "extra": [
            "\n"
          ],
          "color": "blue",
          "bold": true,
          "underlined": true,
          "click_event": {
            "action": "open_url",
            "url": "https://minecraft.wiki/w/Function_(Java_Edition)#Returning"
          },
          "hover_event": {
            "action": "show_text",
            "value": "https://minecraft.wiki/w/Function_(Java_Edition)#Returning"
          }
        },
        {
          "text": "TODO: see ",
          "italic": true,
          "color": "yellow",
          "extra": [
            "",
            {
              "text": "issue #9",
              "color": "blue",
              "underlined": true,
              "click_event": {
                "action": "open_url",
                "url": "https://github.com/xViaOnGithub/Eseframe/issues/9"
              },
              "hover_event": {
                "action": "show_text",
                "value": "https://github.com/xViaOnGithub/Eseframe/issues/9"
              }
            },
            "\n"
          ]
        }
      ]
    ]
  },
  "title": "eseframe_api-v1:craft_tag",
  "external_title": "eseframe_api-v1:craft_tag",
  "can_close_with_escape": true,
  "action": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "eseframe:docs/api_reference/function/index"
    }
  }
}