{
  "type": "minecraft:notice",
  "body": {
    "type": "minecraft:plain_message",
    "contents": [
      "",
      "Tries to craft a custom recipe with the items of a player or a block.\n",
      "\n\n",
      [
        "",
        {
          "text": "Description",
          "extra": [
            "\n"
          ],
          "bold": true
        },
        {
          "text": "Attempts to perform a registered custom recipe. It starts by checking if the player has all of it's ingredients, and then if they do, it removes the ingredients from their inventory and gives them loot table `<namespace>:eseframe_api/recipe/<id>`.\n\nIf key `block` is set to true, it checks for ingredients and invokes the loot table at the block the function was invoked at instead.",
          "color": "gray",
          "extra": [
            "\n"
          ]
        }
      ],
      "\n\n",
      [
        "",
        {
          "text": "Macro Keys",
          "extra": [
            "\n"
          ],
          "color": "blue",
          "bold": true,
          "underlined": true,
          "click_event": {
            "action": "open_url",
            "url": "https://minecraft.wiki/w/Function_(Java_Edition)#Macros"
          },
          "hover_event": {
            "action": "show_text",
            "value": "https://minecraft.wiki/w/Function_(Java_Edition)#Macros"
          }
        },
        {
          "text": "id",
          "extra": [
            " ",
            {
              "text": "string",
              "italic": true
            },
            " : ",
            {
              "text": "The id the recipe was added under.",
              "color": "gray"
            },
            "\n"
          ]
        },
        {
          "text": "namespace",
          "extra": [
            " ",
            {
              "text": "string",
              "italic": true
            },
            " : ",
            {
              "text": "The namespace the recipe was added under.",
              "color": "gray"
            },
            "\n"
          ]
        },
        {
          "text": "block",
          "extra": [
            " ",
            {
              "text": "booleen",
              "italic": true
            },
            " : ",
            {
              "text": "When set to true, check for ingredients at and send results to the block that the function is invoked at",
              "color": "gray"
            },
            "\n"
          ]
        }
      ],
      "\n\n",
      [
        "",
        {
          "text": "Return Values",
          "extra": [
            "\n"
          ],
          "color": "blue",
          "bold": true,
          "underlined": true,
          "click_event": {
            "action": "open_url",
            "url": "https://minecraft.wiki/w/Function_(Java_Edition)#Returning"
          },
          "hover_event": {
            "action": "show_text",
            "value": "https://minecraft.wiki/w/Function_(Java_Edition)#Returning"
          }
        },
        {
          "text": "fail",
          "extra": [
            ": ",
            {
              "text": "Recipe doesn't exist, has no ingredients, or player/block does not have all ingredients",
              "color": "gray"
            },
            "\n"
          ]
        },
        {
          "text": "1",
          "extra": [
            ": ",
            {
              "text": "Recipe was crafted successfully",
              "color": "gray"
            },
            "\n"
          ]
        }
      ]
    ]
  },
  "title": "eseframe_api:v1/craft",
  "external_title": "eseframe_api:v1/craft",
  "can_close_with_escape": true,
  "action": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "eseframe:docs/api_reference/function/index"
    }
  }
}