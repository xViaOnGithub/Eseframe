{
  "type": "minecraft:notice",
  "title": "Eseframe Documentation: Cheat Sheet",
  "external_title": "Cheat Sheet (Needs testing)",
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": [
        "",
        {
          "text": "TODO: Test each copyable data, then make it have consistant spacing",
          "bold": true,
          "extra": [
            "\n"
          ]
        },
        {
          "text": "Click on underlined text to copy it's data to clipboard.",
          "italic": true,
          "extra": [
            "\n"
          ]
        },
        "\n\n\n",
        [
          "",
          {
            "text": "Custom Items",
            "extra": [
              "\n"
            ],
            "bold": true
          },
          "\n",
          [
            "",
            {
              "text": "Add custom item",
              "underlined": true,
              "extra": [
                "\n"
              ],
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{id:\"ID\", namespace:\"NAMESPACE\", components: {\"minecraft:item_name\": \"ITEM NAME\", \"minecraft:item_model\": \"minecraft:stick\", \"minecraft:max_stack_size\": 64}, properties: {}}"
              }
            },
            {
              "text": "(in #eseframe_api:v1/register/items)",
              "color": "gray",
              "underlined": false,
              "extra": [
                "\n"
              ]
            }
          ],
          "\n",
          {
            "text": "Give custom item",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/give {id: \"ID\", namespace: \"NAMESPACE\", count: 64}"
            }
          },
          "\n",
          [
            "",
            {
              "text": "Item proxy",
              "underlined": true,
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{\"eseframe_api\":{\"item_proxy\":{\"id\":\"ID\",\"namespace\":\"NAMESPACE\"}}}"
              }
            },
            "\n",
            {
              "text": "Include in minecraft:custom_data",
              "color": "gray",
              "extra": [
                "\n"
              ]
            },
            {
              "text": "(Replaces it with a custom item)",
              "color": "gray"
            },
            "\n"
          ],
          "\n\n",
          {
            "text": "Run functions while using:",
            "underlined": false,
            "extra": [
              "\n",
              {
                "text": "#<namespace>:eseframe_api/item/<id>/use_hold",
                "color": "gray"
              },
              "\n"
            ]
          },
          "\n",
          {
            "text": "Run functions when begin using:",
            "underlined": false,
            "extra": [
              "\n",
              {
                "text": "#<namespace>:eseframe_api/item/<id>/use_press",
                "color": "gray"
              },
              "\n"
            ]
          },
          "\n",
          {
            "text": "Run functions when consumed:",
            "underlined": false,
            "extra": [
              "\n",
              {
                "text": "#<namespace>:eseframe_api/item/<id>/consume",
                "color": "gray"
              },
              "\n"
            ]
          }
        ],
        "\n\n\n",
        "\n\n\n",
        [
          "",
          {
            "text": "Custom Tag Recipes",
            "extra": [
              "\n"
            ],
            "bold": true
          },
          "\n",
          [
            "",
            {
              "text": "Add custom recipe to tag",
              "underlined": true,
              "extra": [
                "\n"
              ],
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "function eseframe_api:v1/tag_recipe {id:\"RECIPE_ID\",namespace:\"RECIPE_NAMESPACE\",tag_id:\"TAG_ID\",tag_namespace:\"TAG_NAMESPACE\"}"
              }
            },
            {
              "text": "(in #eseframe_api:v1/register/recipe_tags)",
              "color": "gray",
              "extra": [
                "\n",
                "Tags are created automatically when set",
                "\n"
              ]
            }
          ],
          "\n",
          [
            "Define recipe results",
            "\n",
            {
              "text": "with loot table <namespace>:eseframe_api/recipe/<id>",
              "color": "gray",
              "extra": [
                "\n"
              ]
            }
          ],
          "\n\n",
          {
            "text": "Craft first recipe as player",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: false}"
            }
          },
          "\n",
          {
            "text": "Craft first valid recipe with block",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: true}"
            }
          }
        ]
      ]
    },
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "",
          "italic": true
        },
        {
          "text": "Click on ",

          "extra": [
            "",
            {
              "text": "underlined text",
              "underlined": true,

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "underlined text"
              }
            },
            " to copy it to the clipboard.",
            "\n"
          ]
        },
        {
          "text": "Some lines will give you extra info when you hover over them.",
          "color": "gray",

          "hover_event": {
            "action": "show_text",
            "value": "Tooltips are used to provide relevant details about the line; For example, a tooltip may include the context a function should be ran under."
          }
        }
      ]
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": [
        [
          "",
          {
            "text": "Adding New Recipes",
            "color": "gold",
            "bold": true,
            "extra": ["\n"]
          },

          "\n",

          [
            "",
            {
              "text": "Register a recipe:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "TODO: command to copy (dont forget to also have the final command copied when clicked)",
              "color": "red",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": [
                  "DURING function tag #eseframe_api:v1/register/recipes"
                ]
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "INSERT COMMAND HERE"
              }
            }
          ],
          "\n\n",
          [
            "",
            {
              "text": "Set what items a recipe gives when crafted:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "Define loot table <recipe_namespace>:eseframe_api/recipe/<recipe_id>",
              "color": "gray",
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": [
                  "Path: <your_datapack>/data/<recipe_namespace>/loot_table/eseframe_api/recipe/<recipe_id>.json",
                  "\n",
                  "TIP: You can use Item Proxies to give a player a custom item when they craft your recipe!"
                ]
              }
            }
          ]
        ],
        "\n\n\n",
        [
          "",
          {
            "text": "Ingredients",
            "color": "gold",
            "bold": true,
            "extra": ["\n"]
          },

          "\n",

          [
            "",
            {
              "text": "Custom item added with Eseframe:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "{type:\"custom_item\",id:\"<recipe_id>\",namespace:\"<recipe_namespace>\",count:1}",
              "color": "gray",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{type:\"custom_item\",id:\"<recipe_id>\",namespace:\"<recipe_namespace>\",count:1}"
              }
            }
          ],
          "\n\n",
          [
            "",
            {
              "text": "Regular item:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "{type:\"item\",item:\"minecraft:ITEM_ID\",count:1}",
              "color": "gray",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",count:1}"
              }
            }
          ],
          "\n\n",
          [
            "",
            {
              "text": "Regular item with components:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "{type:\"item\",item:\"minecraft:ITEM_ID\",predicates:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}",
              "color": "gray",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",predicates:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}"
              }
            }
          ],
          "\n\n",
          [
            "",
            {
              "text": "Regular item with exact components:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "{type:\"item\",item:\"minecraft:ITEM_ID\",components:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}",
              "color": "gray",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": "Add this to the \"ingredients\" key of function eseframe_api:v1/add_recipe"
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",components:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"string values must be in double and single quotes\"'}],count:1}"
              }
            }
          ]
        ],
        "\n\n\n",
        [
          "",
          {
            "text": "Crafting",
            "color": "gold",
            "bold": true,
            "extra": ["\n"]
          },

          "\n",

          [
            "",
            {
              "text": "Craft a recipe with a player's items:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:false}",
              "color": "gray",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": [
                  "AS the player with the ingredients"
                ]
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:false}"
              }
            }
          ],
          "\n\n",
          [
            "",
            {
              "text": "Craft a recipe with a block's items:",
              "color": "white",
              "extra": ["\n"]
            },
            {
              "text": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:true}",
              "color": "gray",
              "underlined": true,
              "extra": ["\n"],

              "hover_event": {
                "action": "show_text",
                "value": [
                  "AS the player to credit the crafting to",
                  "\n",
                  "AT the block with the ingredients"
                ]
              },

              "click_event": {
                "action": "copy_to_clipboard",
                "value": "function eseframe_api:v1/craft {id:\"ID\",namespace:\"NAMESPACE\",block:true}"
              }
            }
          ]
        ]
      ]
    }
  ],
  "inputs": [],
  "after_action": "none",
  "pause": false,
  "action": {
    "label": {
      "translate": "gui.ok"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "eseframe:docs/index"
    }
  }
}