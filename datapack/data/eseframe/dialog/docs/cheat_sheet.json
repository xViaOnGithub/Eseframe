{
  "type": "minecraft:notice",
  "title": "Eseframe Documentation: Cheat Sheet",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": [
        "",
        {
          "text": "TODO: Test each copyable data, then make it have consistant spacing",
          "bold": true,
          "extra": [
            "\n"
          ]
        },
        {
          "text": "Click on underlined text to copy it's data to clipboard.",
          "italic": true,
          "extra": [
            "\n"
          ]
        },
        "\n\n\n",
        [
          "",
          {
            "text": "Custom Items",
            "extra": [
              "\n"
            ],
            "bold": true
          },
          "\n",
          [
            "",
            {
              "text": "Add custom item",
              "underlined": true,
              "extra": [
                "\n"
              ],
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{id:\"ID\", namespace:\"NAMESPACE\", components: {\"minecraft:item_name\": \"ITEM NAME\", \"minecraft:item_model\": \"minecraft:stick\", \"minecraft:max_stack_size\": 64}, properties: {}}"
              }
            },
            {
              "text": "(in #eseframe_api:v1/register/items)",
              "color": "gray",
              "underlined": false,
              "extra": [
                "\n"
              ]
            }
          ],
          "\n",
          {
            "text": "Give custom item",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/give {id: \"ID\", namespace: \"NAMESPACE\", count: 64}"
            }
          },
          "\n",
          [
            "",
            {
              "text": "Item proxy",
              "underlined": true,
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "{\"eseframe_api\":{\"item_proxy\":{\"id\":\"ID\",\"namespace\":\"NAMESPACE\"}}}"
              }
            },
            "\n",
            {
              "text": "Include in minecraft:custom_data",
              "color": "gray",
              "extra": [
                "\n"
              ]
            },
            {
              "text": "(Replaces it with a custom item)",
              "color": "gray"
            },
            "\n"
          ],
          "\n\n",
          {
            "text": "Run functions while using:",
            "underlined": false,
            "extra": [
              "\n",
              {
                "text": "#<namespace>:eseframe_api/item/<id>/use_hold",
                "color": "gray"
              },
              "\n"
            ]
          },
          "\n",
          {
            "text": "Run functions when begin using:",
            "underlined": false,
            "extra": [
              "\n",
              {
                "text": "#<namespace>:eseframe_api/item/<id>/use_hold",
                "color": "gray"
              },
              "\n"
            ]
          },
          "\n",
          {
            "text": "Run functions when consumed:",
            "underlined": false,
            "extra": [
              "\n",
              {
                "text": "#<namespace>:eseframe_api/item/<id>/on_consume",
                "color": "gray"
              },
              "\n"
            ]
          }
        ],
        "\n\n\n",
        [
          "",
          {
            "text": "Custom Recipes",
            "extra": [
              "\n"
            ],
            "bold": true
          },
          "\n",
          [
            "",
            {
              "text": "Add custom recipe (todo: click to copy)",
              "underlined": true,
              "extra": [
                "\n"
              ],
              "click_event": {
                "action": "copy_to_clipboard",
                "value": ""
              }
            },
            {
              "text": "(in #eseframe_api:v1/register/recipes)",
              "color": "gray",
              "underlined": false,
              "extra": [
                "\n"
              ]
            }
          ],
          "\n",
          {
            "text": "Ingredients",
            "extra": [
              "\n",
              {
                "text": "custom item",
                "color": "gray",
                "underlined": true,
                "click_event": {
                  "action": "copy_to_clipboard",
                  "value": "{type:\"custom_item\",id:\"ID\",namespace:\"NAMESPACE\",count:1}"
                }
              },
              " ",
              {
                "text": "item",
                "color": "gray",
                "underlined": true,
                "click_event": {
                  "action": "copy_to_clipboard",
                  "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",count:1}"
                }
              },
              " ",
              {
                "text": "item with components",
                "color": "gray",
                "underlined": true,
                "click_event": {
                  "action": "copy_to_clipboard",
                  "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",predicates:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"strings must be in double and single quotes\"'}],count:1}"
                }
              },
              " ",
              {
                "text": "item with components (strict)",
                "color": "gray",
                "underlined": true,
                "click_event": {
                  "action": "copy_to_clipboard",
                  "value": "{type:\"item\",item:\"minecraft:ITEM_ID\",components:[{id:\"minecraft:custom_data\",value:{key:\"value\"}},{id:\"minecraft:custom_name\",value:'\"strings must be in double and single quotes\"'}],count:1}"
                }
              },
              "\n"
            ]
          },
          "\n",
          [
            "Define recipe results",
            "\n",
            {
              "text": "with loot table <namespace>:eseframe_api/recipe/<id>",
              "color": "gray",
              "extra": [
                "\n"
              ]
            }
          ],
          "\n\n",
          {
            "text": "Craft as player",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: false}"
            }
          },
          "\n",
          {
            "text": "Craft with block",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: true}"
            }
          }
        ],
        "\n\n\n",
        [
          "",
          {
            "text": "Custom Tag Recipes",
            "extra": [
              "\n"
            ],
            "bold": true
          },
          "\n",
          [
            "",
            {
              "text": "Add custom recipe to tag",
              "underlined": true,
              "extra": [
                "\n"
              ],
              "click_event": {
                "action": "copy_to_clipboard",
                "value": "function eseframe_api:v1/tag_recipe {id:\"RECIPE_ID\",namespace:\"RECIPE_NAMESPACE\",tag_id:\"TAG_ID\",tag_namespace:\"TAG_NAMESPACE\"}"
              }
            },
            {
              "text": "(in #eseframe_api:v1/register/recipe_tags)",
              "color": "gray",
              "extra": [
                "\n",
                "Tags are created automatically when set",
                "\n"
              ]
            }
          ],
          "\n",
          [
            "Define recipe results",
            "\n",
            {
              "text": "with loot table <namespace>:eseframe_api/recipe/<id>",
              "color": "gray",
              "extra": [
                "\n"
              ]
            }
          ],
          "\n\n",
          {
            "text": "Craft first recipe as player",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: false}"
            }
          },
          "\n",
          {
            "text": "Craft first valid recipe with block",
            "underlined": true,
            "extra": [
              "\n"
            ],
            "click_event": {
              "action": "copy_to_clipboard",
              "value": "function eseframe_api:v1/craft {id: \"ID\", namespace: \"NAMESPACE\", block: true}"
            }
          }
        ]
      ]
    }
  ],
  "inputs": [],
  "after_action": "none",
  "pause": false,
  "action": {
    "label": {
      "translate": "gui.ok"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "eseframe:docs/index"
    }
  }
}